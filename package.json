{
  "name": "honeydone-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "HoneyDo2Done MVP - Relationship-aware task management platform",
  "workspaces": [
    "supabase/functions",
    "mobile"
  ],
  "scripts": {
    "dev:mobile": "cd mobile && npm start",
    "dev:supabase": "cd supabase && supabase start",
    "db:reset": "cd supabase && supabase db reset",
    "db:migrate": "cd supabase && supabase db push",
    "functions:serve": "cd supabase && supabase functions serve",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
